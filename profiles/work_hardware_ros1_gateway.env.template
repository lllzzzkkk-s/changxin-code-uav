# Unit/workplace real ROS1 gateway profile template.
# Copy to a local .env file on the unit/workplace machine and fill in machine-specific ROS values.
MISSION_PROFILE=work_hardware
MODEL_PROVIDER=mock
MODEL_BASE_URL=
MODEL_NAME=
PLANNER_BACKEND=mock
PLATFORM_BACKEND=ros1_gateway
MISSION_STATE_STORE=json
MISSION_ARTIFACT_ROOT=./runs/work_hardware_ros1_gateway
ROS_MASTER_URI=http://<platform-or-gateway-ros-master>:11311
ROS_IP=<this-workstation-or-gateway-ip>
HARDWARE_APPROVAL_REQUIRED=true
ROS_GATEWAY_DISPATCH_SERVICE_TEMPLATE=/fleet/{platform_id}/gateway/dispatch
ROS_GATEWAY_DRY_RUN_SERVICE_TEMPLATE=/fleet/{platform_id}/gateway/dry_run

# Home 5090 lane: model capability testing only. It must not dispatch to hardware.
MISSION_PROFILE=home_model_lab
MODEL_PROVIDER=local_http
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_NAME=qwen3.5-35b-a3b
MODEL_LAB_EVIDENCE_KIND=home_5090_live
PLANNER_BACKEND=mock
PLATFORM_BACKEND=mock
MISSION_STATE_STORE=json
MISSION_ARTIFACT_ROOT=./runs/home_model_lab
ROS_MASTER_URI=
ROS_IP=
HARDWARE_APPROVAL_REQUIRED=false
ROS_GATEWAY_DISPATCH_SERVICE_TEMPLATE=/fleet/{platform_id}/gateway/dispatch
ROS_GATEWAY_DRY_RUN_SERVICE_TEMPLATE=/fleet/{platform_id}/gateway/dry_run
